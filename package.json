{
  "name": "react-native-inapp-inspector",
  "version": "2.3.10",
  "description": "The zero-config, all-in-one in-app debugger for React Native & Expo. Inspect Network (fetch/axios), Console logs, Stack Traces, Redux State, Firebase Analytics, and JS Bundle size directly on device.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vengatmacuser/react-native-inapp-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/vengatmacuser/react-native-inapp-inspector/issues",
    "email": "vengatmacuser@gmail.com"
  },
  "homepage": "https://github.com/vengatmacuser/react-native-inapp-inspector#readme",
  "main": "dist/commonjs/index.js",
  "module": "dist/esm/index.js",
  "react-native": "dist/commonjs/index.js",
  "types": "dist/commonjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./dist/commonjs/index.js",
      "types": "./dist/commonjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/commonjs/index.js",
      "default": "./dist/commonjs/index.js"
    },
    "./network": {
      "react-native": "./dist/commonjs/network.js",
      "types": "./dist/commonjs/network.d.ts",
      "import": "./dist/esm/network.js",
      "require": "./dist/commonjs/network.js",
      "default": "./dist/commonjs/network.js"
    },
    "./redux": {
      "react-native": "./dist/commonjs/redux.js",
      "types": "./dist/commonjs/redux.d.ts",
      "import": "./dist/esm/redux.js",
      "require": "./dist/commonjs/redux.js",
      "default": "./dist/commonjs/redux.js"
    },
    "./console": {
      "react-native": "./dist/commonjs/console.js",
      "types": "./dist/commonjs/console.d.ts",
      "import": "./dist/esm/console.js",
      "require": "./dist/commonjs/console.js",
      "default": "./dist/commonjs/console.js"
    },
    "./crash": {
      "react-native": "./dist/commonjs/crash.js",
      "types": "./dist/commonjs/crash.d.ts",
      "import": "./dist/esm/crash.js",
      "require": "./dist/commonjs/crash.js",
      "default": "./dist/commonjs/crash.js"
    },
    "./analytics": {
      "react-native": "./dist/commonjs/analytics.js",
      "types": "./dist/commonjs/analytics.d.ts",
      "import": "./dist/esm/analytics.js",
      "require": "./dist/commonjs/analytics.js",
      "default": "./dist/commonjs/analytics.js"
    },
    "./performance": {
      "react-native": "./dist/commonjs/performance.js",
      "types": "./dist/commonjs/performance.d.ts",
      "import": "./dist/esm/performance.js",
      "require": "./dist/commonjs/performance.js",
      "default": "./dist/commonjs/performance.js"
    },
    "./bundle": {
      "react-native": "./dist/commonjs/bundle.js",
      "types": "./dist/commonjs/bundle.d.ts",
      "import": "./dist/esm/bundle.js",
      "require": "./dist/commonjs/bundle.js",
      "default": "./dist/commonjs/bundle.js"
    },
    "./storage": {
      "react-native": "./dist/commonjs/storage.js",
      "types": "./dist/commonjs/storage.d.ts",
      "import": "./dist/esm/storage.js",
      "require": "./dist/commonjs/storage.js",
      "default": "./dist/commonjs/storage.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "android",
    "ios",
    "react-native-inapp-inspector.podspec"
  ],
  "codegenConfig": {
    "name": "RNInAppInspectorSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.inappinspector"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "prebuild": "node scripts/gen-version.js && node scripts/gen-telemetry.js",
    "build": "npm run clean && tsc && tsc -p tsconfig.esm.json",
    "prepare": "npm run build",
    "watch": "tsc -w",
    "prepack": "npm run build",
    "release": "node release.cjs",
    "bundle-visualizer": "react-native-bundle-visualizer"
  },
  "keywords": [
    "react-native",
    "react-native-inapp-inspector",
    "network-logger",
    "network-inspector",
    "react-native-network-logger",
    "flipper-alternative",
    "chucker",
    "chucker-react-native",
    "in-app-inspector",
    "in-app-debugger",
    "react-native-debugger",
    "react-native-devtools",
    "devtools",
    "expo",
    "expo-network-logger",
    "http-logger",
    "api-inspector",
    "console-logger",
    "redux-inspector",
    "redux-logger",
    "analytics-logger",
    "bundle-visualizer",
    "hermes",
    "zero-config",
    "debug-tool",
    "ios",
    "android"
  ],
  "author": "Vengateswaran Balakrishnan",
  "contributors": [
    {
      "name": "Vengateswaran Balakrishnan",
      "url": "https://github.com/vengatmacuser"
    }
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/vengatmacuser"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.60.0",
    "react-native-linear-gradient": ">=2.0.0",
    "react-native-svg": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-navigation/native": "6.1.9",
    "@types/react": "19.1.0",
    "@types/react-native": "0.72.0",
    "axios": "1.7.2",
    "prettier": "2.8.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-bundle-visualizer": "4.0.0",
    "react-native-linear-gradient": "2.8.3",
    "react-native-svg": "15.14.0",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "1.16.3"
  }
}
