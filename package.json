{
  "name": "react-native-inapp-inspector",
  "version": "2.4.0",
  "description": "The zero-config, all-in-one in-app debugger & network logger for React Native & Expo (Flipper / Chucker alternative). Inspect Network (fetch/Axios/GraphQL), Console logs with Metro Symbolication, Redux State, Firebase Analytics, Storage (AsyncStorage/MMKV), Hardware Telemetry, and JS Bundle size directly on device.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vengatmacuser/react-native-inapp-inspector.git"
  },
  "bugs": {
    "url": "https://github.com/vengatmacuser/react-native-inapp-inspector/issues",
    "email": "vengatmacuser@gmail.com"
  },
  "homepage": "https://github.com/vengatmacuser/react-native-inapp-inspector#readme",
  "main": "dist/commonjs/index.js",
  "module": "dist/esm/index.js",
  "react-native": "dist/commonjs/index.js",
  "types": "dist/commonjs/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "react-native": "./dist/commonjs/index.js",
      "types": "./dist/commonjs/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/commonjs/index.js",
      "default": "./dist/commonjs/index.js"
    },
    "./network": {
      "react-native": "./dist/commonjs/network.js",
      "types": "./dist/commonjs/network.d.ts",
      "import": "./dist/esm/network.js",
      "require": "./dist/commonjs/network.js",
      "default": "./dist/commonjs/network.js"
    },
    "./redux": {
      "react-native": "./dist/commonjs/redux.js",
      "types": "./dist/commonjs/redux.d.ts",
      "import": "./dist/esm/redux.js",
      "require": "./dist/commonjs/redux.js",
      "default": "./dist/commonjs/redux.js"
    },
    "./console": {
      "react-native": "./dist/commonjs/console.js",
      "types": "./dist/commonjs/console.d.ts",
      "import": "./dist/esm/console.js",
      "require": "./dist/commonjs/console.js",
      "default": "./dist/commonjs/console.js"
    },
    "./crash": {
      "react-native": "./dist/commonjs/crash.js",
      "types": "./dist/commonjs/crash.d.ts",
      "import": "./dist/esm/crash.js",
      "require": "./dist/commonjs/crash.js",
      "default": "./dist/commonjs/crash.js"
    },
    "./analytics": {
      "react-native": "./dist/commonjs/analytics.js",
      "types": "./dist/commonjs/analytics.d.ts",
      "import": "./dist/esm/analytics.js",
      "require": "./dist/commonjs/analytics.js",
      "default": "./dist/commonjs/analytics.js"
    },
    "./storage": {
      "react-native": "./dist/commonjs/storage.js",
      "types": "./dist/commonjs/storage.d.ts",
      "import": "./dist/esm/storage.js",
      "require": "./dist/commonjs/storage.js",
      "default": "./dist/commonjs/storage.js"
    },
    "./capture": {
      "react-native": "./dist/commonjs/capture.js",
      "types": "./dist/commonjs/capture.d.ts",
      "import": "./dist/esm/capture.js",
      "require": "./dist/commonjs/capture.js",
      "default": "./dist/commonjs/capture.js"
    },
    "./push": {
      "react-native": "./dist/commonjs/push.js",
      "types": "./dist/commonjs/push.d.ts",
      "import": "./dist/esm/push.js",
      "require": "./dist/commonjs/push.js",
      "default": "./dist/commonjs/push.js"
    },
    "./metro": {
      "types": "./dist/commonjs/metro.d.ts",
      "import": "./dist/esm/metro.js",
      "require": "./dist/commonjs/metro.js",
      "default": "./dist/commonjs/metro.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "src/native",
    "bin",
    "metro.js",
    "metro.d.ts",
    "README.md",
    "android",
    "ios",
    "react-native-inapp-inspector.podspec"
  ],
  "codegenConfig": {
    "name": "RNInAppInspectorSpec",
    "type": "modules",
    "jsSrcsDir": "src/native",
    "android": {
      "javaPackageName": "com.inappinspector"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "version": "node scripts/gen-version.js && git add src/constants/version.ts",
    "prebuild": "node scripts/gen-version.js && node scripts/gen-telemetry.js",
    "build": "tsc && tsc -p tsconfig.esm.json && node scripts/minify-dist.js",
    "clean-build": "npm run clean && npm run build",
    "prepare": "npm run build",
    "watch": "tsc -w",
    "prepack": "npm run build",
    "release": "node release.cjs",
    "bundle-visualizer": "react-native-bundle-visualizer",
    "serve-apk": "node ./bin/cli.js 8083"
  },
  "bin": {
    "react-native-inapp-inspector": "./bin/cli.js"
  },
  "keywords": [
    "react-native",
    "react-native-inapp-inspector",
    "inapp-inspector",
    "in-app-inspector",
    "in-app-debugger",
    "react-native-debugger",
    "react-native-devtools",
    "devtools",
    "network-logger",
    "network-inspector",
    "react-native-network-logger",
    "http-logger",
    "api-inspector",
    "axios-interceptor",
    "fetch-logger",
    "graphql-inspector",
    "websocket-logger",
    "curl-export",
    "flipper-alternative",
    "chucker",
    "chucker-react-native",
    "proxyman-alternative",
    "charles-proxy",
    "console-logger",
    "metro-symbolication",
    "stacktrace-symbolication",
    "crash-reporter",
    "crash-logger",
    "error-boundary",
    "redux-inspector",
    "redux-logger",
    "redux-devtools",
    "redux-toolkit",
    "rtk-query",
    "redux-persist",
    "analytics-logger",
    "firebase-analytics-debugger",
    "ga4-debugger",
    "storage-inspector",
    "asyncstorage-viewer",
    "asyncstorage-inspector",
    "mmkv-inspector",
    "mmkv-viewer",
    "device-info",
    "hardware-telemetry",
    "ram-monitor",
    "bundle-visualizer",
    "screen-recorder",
    "react-native-screen-recorder",
    "micro-ui",
    "fault-isolated",
    "hermes",
    "expo",
    "expo-network-logger",
    "expo-dev-client",
    "expo-debugger",
    "turbomodules",
    "fabric",
    "react-native-new-architecture",
    "zero-config",
    "debug-tool",
    "ios",
    "android"
  ],
  "author": "Vengateswaran Balakrishnan",
  "contributors": [
    {
      "name": "Vengateswaran Balakrishnan",
      "url": "https://github.com/vengatmacuser"
    }
  ],
  "license": "MIT",
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/vengatmacuser"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-native": ">=0.60.0",
    "react-native-linear-gradient": ">=2.0.0",
    "react-native-svg": ">=12.0.0"
  },
  "peerDependenciesMeta": {
    "@react-navigation/native": {
      "optional": true
    }
  },
  "devDependencies": {
    "@react-navigation/native": "6.1.9",
    "@types/react": "19.1.0",
    "@types/react-native": "0.72.0",
    "axios": "1.7.2",
    "esbuild": "^0.28.2",
    "prettier": "2.8.8",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-bundle-visualizer": "4.0.0",
    "react-native-linear-gradient": "2.8.3",
    "react-native-svg": "15.14.0",
    "terser": "^5.51.2",
    "typescript": "5.8.3"
  },
  "dependencies": {
    "@react-native-clipboard/clipboard": "1.16.3"
  }
}
